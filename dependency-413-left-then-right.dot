  "411" [label="#411  Implement lane-move mutation with path-preserving validation", style="filled", fillcolor="white"];
  "412" [label="#412  Bug: Fix lanes select grammar, help, completion, and invalid-token diagnostics", style="filled", fillcolor="mistyrose"];
  "413" [label="#413  Certify lane move and command-diagnostic workflow", style="filled", fillcolor="gold"];
  "451" [label="#451  Bug: Investigate malformed vertical routing in complex lane graphs", style="filled", fillcolor="mistyrose"];
  "452" [label="#452  Add group-boundary --follow control to lane traversal", style="filled", fillcolor="white"];
  "453" [label="#453  Add --show-children context for stopped lane group boundaries", style="filled", fillcolor="white"];
  "454" [label="#454  Add --max-depend-depth limit to lane dependency traversal", style="filled", fillcolor="white"];
  "456" [label="#456  Refactor: Replace _variadic command tails with quantified command/switch/parameter grammar", style="filled", fillcolor="khaki1"];
