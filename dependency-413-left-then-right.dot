digraph "RepoWorkflow #413 left-then-right traversal" {
  graph [rankdir=LR, overlap=false, splines=true, bgcolor="white"];
  node [shape=box, fontsize=10, fontcolor="black"];
  edge [arrowsize=0.7];

  // Traversal: seed -> dependencies to terminal leaves, then
  // terminal leaves -> dependants to exhaustion.
  // Display direction: dependency -> dependant.
  // Seed=gold, Feature=lightblue, Epic=palegreen, Initiative=plum,
  // Bug=mistyrose, Refactor=khaki1, ordinary=white.

  "409" [label="#409  Epic: Restore lane selection move workflow and correct select grammar/help", style="filled", fillcolor="palegreen"];
