  "462" [label="#462  Add --follow back-only dependency traversal", style="filled", fillcolor="white"];
  "463" [label="#463  Add umbrella-only --filter projection to lane graphs", style="filled", fillcolor="white"];
  "464" [label="#464  Certify focused lane traversal and umbrella filtering controls", style="filled", fillcolor="white"];
  "473" [label="#473  Feature: Add risk-scoped issue verification and staged Self CI", style="filled", fillcolor="lightblue"];
  "474" [label="#474  Define test-catalogue aliases and durable high-risk issue associations", style="filled", fillcolor="white"];
  "475" [label="#475  Implement rwf high-risk catalogue-section association", style="filled", fillcolor="white"];
  "476" [label="#476  Stage Self CI by issue verification, regression, and integration risk", style="filled", fillcolor="white"];
  "477" [label="#477  Certify risk-scoped testing and staged Self CI workflow", style="filled", fillcolor="white"];
  "478" [label="#478  Bug: Advance stable version after quantified-grammar release collision", style="filled", fillcolor="mistyrose"];
  "516" [label="#516  Add --count dry-run size for lane selection without graph rendering", style="filled", fillcolor="white"];
  "521" [label="#521  Bug: Fix nested command descriptions in generated help", style="filled", fillcolor="mistyrose"];

  "413" -> "409";
  "410" -> "411";
  "410" -> "412";
  "456" -> "412";
  "410" -> "413";
