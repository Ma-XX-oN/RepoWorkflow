#!/bin/sh
# RWF requires Python >= 3.10; executable names vary by platform.
# Probe candidates rather than trusting command presence: on Windows, python3
# may be a Microsoft Store app-execution alias that exists but is unusable.
for RWF_PYTHON in python3 python; do
  if command -v "$RWF_PYTHON" >/dev/null 2>&1 &&
      "$RWF_PYTHON" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
        >/dev/null 2>&1; then
    exec "$RWF_PYTHON" "$(dirname "$0")/repo_workflow.py" "$@"
  fi
done

echo "rwf: Python 3.10 or newer is required; install a supported Python and ensure 'python3' or 'python' is on PATH." >&2
exit 127
